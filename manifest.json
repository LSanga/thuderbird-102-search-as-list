{
  "manifest_version": 2,
  "name": "Search as List",
  "version": "1.0.0",
  "description": "Automatically shows global search results as a message list instead of the faceted (card) view.",
  "author": "Luca",
  "browser_specific_settings": {
    "gecko": {
      "id": "search-as-list@luca-san.com",
      "strict_min_version": "102.0",
      "strict_max_version": "102.*"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "experiment_apis": {
    "searchAsList": {
      "schema": "api/searchAsList/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["searchAsList"]],
        "script": "api/searchAsList/implementation.js"
      }
    }
  }
}
